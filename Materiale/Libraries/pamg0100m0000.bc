|*************************** declaration section *******************************
declaration:
	table	ttxamg000	|* Parameters

	extern	domain	tcmcs.long	records.marked

	#include <bic_dam>
	|#include "itcmcs0095.ui"	|* Parameters
	|#include "itcmcs2000"		|* DAL(-GUI) Support Defines
	|#include "itcmcs2001"		|* GUI Support Defines
	|#include "itcmcs2010"		|* Disable/enable and segmentation
	#include "itxadv0000"	|* Common declares for Altea Development Tools

	#pragma nowarnings

	domain	tcbool		itcmcs0095.done
	domain	tcdate		itcmcs0095.indt
	domain	tcbool		itcmcs0095.conversion.necessary
	domain	tcncmp		itcmcs0095.company


|****************************** DEFINES FROM INCLUDES *******************************
	#define HANDLE.ADD(TABLE)
^		HANDLE.ADD(TABLE, indt)

	#define	HANDLE.ADD(TABLE, INDT)
^		if not itcmcs0095.done then
^			select	##TABLE##.##INDT##:itcmcs0095.indt
^			from	##TABLE##
^			as set with 1 rows
^			selectdo
^				itcmcs0095.done = true
^				disable.commands(add.set)
^			endselect
^		endif

	#define	HANDLE.ADD.COMPANY(TABLE, NCMP)
^		if not itcmcs0095.done then
^			select	##TABLE##.##INDT##:itcmcs0095.indt
^			from	##TABLE##
^			where	##TABLE##._index1 = { 0, :NCMP}
^			as set with 1 rows
^			selectdo
^				itcmcs0095.done = true
^				disable.commands(add.set)
^			endselect
^		endif
	#define	HANDLE.MARK(TABLE)
^		HANDLE.MARK(TABLE, indt)

	#define	HANDLE.MARK(TABLE, INDT)
^		if ##TABLE##.##INDT## = 0 then
^			enable.commands(modify.set)
^		else
^			disable.commands(modify.set)
^		endif
	#define	SET.ACTUAL.SET(TABLE)
^		SET.ACTUAL.SET(TABLE, indt, dsca, true)

	#define SET.ACTUAL.SET(TABLE, REFRESH)
^		SET.ACTUAL.SET(TABLE, indt, dsca, REFRESH)

	#define	SET.ACTUAL.SET(TABLE, INDT, DSCA, REFRESH)
^		if REFRESH then
^			refresh.curr.occ()
^		endif



|****************************** program section *******************************

before.program:
	switch.to.company(ADVCMP)
	set.synchronized.dialog("txamg0100m000")
	|* Parameters

before.display.object:
	HANDLE.ADD(txamg000)


|****************************** choice section ********************************

choice.mark.occur:
after.choice:
	HANDLE.MARK(txamg000)
	records.marked = number.of.marks

choice.update.db:
after.update.db.commit:
	SET.ACTUAL.SET(txamg000)
	refresh.parent(-1)


functions:
function boolean itcmcs0095.conversion.needed(
			string		file(8),
					...)
{
	|* This function checks if a parameter which need a conversion
	|*process is changed

			long		itcmcs0095.table_id
			long		itcmcs0095.i

	if isspace(get.string.arg(2)) then
		return(false)
	endif
	itcmcs0095.table_id = db.bind("t" & file)
	for itcmcs0095.i = 2 to get.argc()
		|if (dal.get.property.flag(file, itcmcs0095.table_id,
		|   file & "." & get.string.arg(itcmcs0095.i)) = DAL_UPDATE) then
			db.unbind(itcmcs0095.table_id)
			return (true)
		|endif

	endfor
	db.unbind(itcmcs0095.table_id)
	return(false)
}
