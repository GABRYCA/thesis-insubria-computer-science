|******************************************************************************
|* txamg3200  0  VRC B61O a  ext
|* Execute Batch Runs
|* Bevacqua Roberto
|* 2026-04-08
|******************************************************************************
|* Main table txamg300 Runs, Form Type 4
|******************************************************************************

|****************************** declaration section ***************************
declaration:
#include "itxadv0000"

	table	ttxamg000
	table	ttxamg100
	table	ttxamg110

	table	ttxamg200
	table	ttxamg201

	table	ttxamg300 |* Runs

	extern	domain	txamg.cbat	cbat.f	fixed
	extern	domain	txamg.cbat	cbat.t	fixed

		domain	tcpath2		cprs,odll,fdll
		domain	tcmcs.str215m	error.message
			long		ret

|****************************** program section ********************************
before.program:
	txamg.dll0013.read.parameters()

|****************************** group section **********************************

group.1:
init.group:
	get.screen.defaults()

field.cbat.f:
when.field.changes:
	cbat.t = cbat.f

functions:
function extern void process.batch.run()
{
	domain  tcmcs.long runs

	select	txamg200.*
	from	txamg200
	where	txamg200._index1 inrange {:cbat.f} and {:cbat.t}
	and	txamg200._compnr = ADVCMP
	selectdo
		txamg.dll0011.log.start.runs(txamg200.cbat,runs)
		select  txamg201.*, txamg100.*, txamg110.*
		from    txamg201, txamg100, txamg110
		where   txamg201._index1 = {:txamg200.cbat}
		and	txamg201.cmbb refers to txamg110
		and	txamg110.grou refers to txamg100
		and	txamg201._compnr = ADVCMP
		and	txamg100._compnr = ADVCMP
		and	txamg110._compnr = ADVCMP
		selectdo
			cprs = txamg000.prpk&txamg000.prmd&txamg201.cprs
			odll = "o"&cprs
			fdll = txamg000.prpk&txamg000.prmd&"."&trim$(txamg201.cprs)&".process.import.file."&trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)
			if exec_dll_function(odll,fdll,ret) then
				error.message ="Error calling dll:"&trim$(fdll)
			endif
		selectempty
		endselect
	endselect
}
