#include "itxadv0000"

	table	ttxamg000	|* AlteaIN Migration Tool Parameters
	table	ttxamg100	|* Table Groups
	table	ttxamg110	|* DataFiles
	table	ttxamg111	|* DataFile Fields
	table	ttxamg200	|* Batch
	table	ttxamg201	|* BatchSequences
	table	ttxamg202	|* Target Tables
	table	ttxamg203	|* MappedFields
	table	ttxamg300	|* Runs by Batch
	table	ttxamg301	|* Runs by Batch/Datafile
	table	ttxamg302	|* Runs by Batch/Datafile/Table
	table	ttxamg303	|* Runs Errors

	table	tttadv400	|* Domains
	table	tttadv420	|* Table Definitions
	table	tttadv421	|* Table Indices
	table	tttadv422	|* Table Fields
	table	tttadv423	|* Child Fields
	table	tttadv438	|* Table fields for Multi Data Language Support
	table	tttadv491	|* Customer Defined Fields

function extern txamg.dll0011.log.start.runs(    	domain txamg.cbat cbat
						,ref 	domain tcmcs.long runs)
{
	db.retry.point()
	runs = 1
	select  max(txamg300.runs):runs
	from    txamg300
	where   txamg300._index1 = {:cbat}
	and	txamg300._compnr = ADVCMP
	group by txamg300.cbat
	as set with 1 rows
	selectdo
		runs = runs+1
	selectempty
	endselect
	db.set.to.default(ttxamg300)
	txamg300.cbat = cbat
	txamg300.runs = runs
	txamg300.ncmp = get.compnr()
	txamg300.stdt = utc.num()
	txamg300.endt = 0
       	txamg300._compnr = ADVCMP
	db.insert(ttxamg300,db.retry)
	db.set.to.default(ttxamg301)
	txamg301.cbat = cbat
	txamg301.runs = runs
	txamg301.sequ = 1
	txamg301.stdt = txamg300.stdt
	txamg301.endt = 0
	txamg301.rere = 0
	txamg301.repr = 0
	txamg301.reer = 0
	txamg301._compnr = ADVCMP
	db.insert(ttxamg301,db.retry)
	db.set.to.default(ttxamg302)
	txamg302.cbat = cbat
	txamg302.runs = runs
	txamg302.sequ = 1
	txamg302.sseq = 1
	txamg302.stdt = txamg300.stdt
	txamg302.endt = 0
	txamg302._compnr = ADVCMP
	db.insert(ttxamg302,db.retry)
	commit.transaction()
}
function extern txamg.dll0011.log.start.datafile( domain txamg.cbat cbat
						 ,domain tcmcs.long runs
						 ,domain tcmcs.long sequ)
{
	db.retry.point()
	select  txamg301.*
	from    txamg301 for update
	where   txamg301._index1 = {:cbat,:runs,:sequ}
	and	txamg301._compnr = ADVCMP
	as set with 1 rows
	selectdo
	selectempty
		db.set.to.default(ttxamg301)
		txamg301.cbat = cbat
		txamg301.runs = runs
		txamg301.sequ = sequ
		txamg301.stdt = utc.num()
		txamg301.endt = 0
		txamg301.rere = 0
		txamg301.repr = 0
		txamg301.reer = 0
		txamg301._compnr = ADVCMP
		db.insert(ttxamg301,db.retry,db.skip.dupl)
	endselect
	commit.transaction()
}
function extern txamg.dll0011.log.start.table(   domain txamg.cbat cbat
						,domain tcmcs.long runs
						,domain tcmcs.long sequ
						,domain tcmcs.long sseq)
{
	db.retry.point()
	select  txamg302.*
	from    txamg302 for update
	where   txamg302._index1 = {:cbat,:runs,:sequ,:sseq}
	and	txamg302._compnr = ADVCMP
	as set with 1 rows
	selectdo
	selectempty
		db.set.to.default(ttxamg302)
		txamg302.cbat = cbat
		txamg302.runs = runs
		txamg302.sequ = sequ
		txamg302.sseq = sseq
		txamg302.stdt = utc.num()
		txamg302.endt = 0
		txamg302._compnr = ADVCMP
		db.insert(ttxamg302,db.retry,db.skip.dupl)
	endselect
	commit.transaction()
}
function extern txamg.dll0011.log.end.datafile( domain txamg.cbat cbat
						 ,domain tcmcs.long runs
						 ,domain tcmcs.long sequ
						 ,domain tcmcs.long rere
						 ,domain tcmcs.long repr
						 ,domain tcmcs.long reer
						 )
{
	db.retry.point()
	select  txamg301.*
	from    txamg301 for update
	where   txamg301._index1 = {:cbat,:runs,:txamg202.sequ}
	and	txamg301._compnr = ADVCMP
	as set with 1 rows
	selectdo
		txamg301.endt = utc.num()
		txamg301.rere = rere
		txamg301.repr = repr
		txamg301.reer = reer
		txamg301._compnr = ADVCMP
		db.update(ttxamg301,db.retry)
	endselect
	select  txamg300.*
	from    txamg300 for update
	where   txamg300._index1 = {:cbat,:runs}
	and	txamg300._compnr = ADVCMP
	as set with 1 rows
	selectdo
		txamg300.endt = utc.num()
		txamg300._compnr = ADVCMP
		db.update(ttxamg300,db.retry)
	endselect
	commit.transaction()
}

function extern txamg.dll0011.log.end.table( domain txamg.cbat cbat, domain tcmcs.long runs,domain tcmcs.long sequ, domain tcmcs.long sseq)
{
	db.retry.point()
	select  txamg302.*
	from    txamg302 for update
	where   txamg302._index1 = {:cbat,:runs,:sequ,:sseq}
	and	txamg302._compnr = ADVCMP
	as set with 1 rows
	selectdo
		txamg302.endt = utc.num()
		txamg302._compnr = ADVCMP
		db.update(ttxamg302,db.retry)
	endselect
	select  txamg301.*
	from    txamg301 for update
	where   txamg301._index1 = {:cbat,:runs,:sequ}
	and	txamg301._compnr = ADVCMP
	as set with 1 rows
	selectdo
		txamg301.endt = utc.num()
		txamg301._compnr = ADVCMP
		db.update(ttxamg301,db.retry)
	endselect
	select  txamg300.*
	from    txamg300 for update
	where   txamg300._index1 = {:cbat,:runs}
	and	txamg300._compnr = ADVCMP
	as set with 1 rows
	selectdo
		txamg300.endt = utc.num()
		txamg300._compnr = ADVCMP
		db.update(ttxamg300,db.retry)
	endselect
	commit.transaction()
}

function extern txamg.dll0011.log.error(   domain txamg.cbat cbat
					  ,domain tcmcs.long 	runs
					  ,domain tcmcs.long 	sequ
					  ,domain tcmcs.long 	sseq
					  ,domain tcmcs.long 	rere
					  ,domain tcmcs.int	errc
					  ,domain tcmcs.s999m	errm
					  )
{
	domain	tcmcs.long	line
	line = 1
	|* we assume that the current record of txamg202 is set (eventually with 0 values for sequ, sseq)
	db.retry.point()
	select  max(txamg303.line):line
	from    txamg303
	where   txamg303._index1 = {:cbat,:runs,:sequ,:sseq}
	and	txamg303._compnr = ADVCMP
	group by txamg303.cbat,txamg303.runs,txamg303.sequ,txamg303.sseq,txamg303.rere
	as set with 1 rows
	selectdo
		line = line+1
	selectempty
	endselect
	|* we can add a new log record
	db.set.to.default(ttxamg303)
	txamg303.cbat = cbat
	txamg303.runs = runs
	txamg303.sequ = sequ
	txamg303.sseq = sseq
	txamg303.rere = rere
	txamg303.line = line
	txamg303.errc = errc
	txamg303.errm = errm
	txamg303._compnr = ADVCMP
	db.insert(ttxamg303,db.retry)
	commit.transaction()
}
function extern txamg.dll0011.refresh.table.definition(	domain txamg.cbat cbat,
							domain tcmcs.int  sequ,
							domain tcmcs.int  sseq
							)
{
	domain	ttadv.vers	vers
	domain	ttadv.rele	rele
	domain	ttadv.cust	cust
		long		i ,ppos, ret
	domain	ttadv.fdnm	fdnm
	domain	ttaad.pacc	pacc
	domain	txamg.cpac	cpac
	domain	txamg.cmod	cmod
	domain	txamg.flno	flno
	domain	txamg.fdno	max_fdno

	pacc = curr.pacc$ 	|current package combination
	|* aggiorno i dati di testata della tabella (descrizione e VRC di appartenenza)
	db.retry.point()
	select  txamg202.*,txamg201.*
	from    txamg202 for update ,txamg201
	where   txamg202._index1 = {:cbat,:sequ,:sseq}
	and	txamg202.cmbb refers to txamg201
	selectdo
		cpac = txamg202.cpac
		cmod = txamg202.cmod
		flno = txamg202.flno
		txamg.dll0010.read.current.table.definition(	cpac,cmod,flno,
								vers,rele,cust,
								txamg202.flnm)
		db.update(ttxamg202, db.retry)
	endselect
	commit.transaction()
	|* aggiorno i campi di tabella relativamente alle informazioni non imputabili manualmente
	|* al primo giro imposto tutti i campi con una descrizione "!! DELETED !!", in modo che sia evidente se e' stato tolto dalla definizione
	|* inoltre pulisco le informazioni non editabili ad eccezione del nome campo
	db.retry.point()
	select  txamg203.*
	from    txamg203 for update
	where   txamg203._index1 = {:cbat,:sequ,:sseq}
	selectdo
		txamg203.fdsc = "!! DELETED !!"
		txamg203.comb = empty
		txamg203.pacd = ""
		txamg203.cdom = ""
		txamg203.type = empty
		txamg203.digb = 0
		txamg203.diga = 0
		txamg203.iniv = ""
		txamg203.rfpa = ""
		txamg203.rfmo = ""
		txamg203.rffn = ""
		txamg203.rffd = ""
		txamg203.dept = 1
		txamg203.refm = empty
		txamg203.pkey = tcyesno.no
		txamg203.icdf = tcyesno.no
		txamg203.isml = tcyesno.no
		db.update(ttxamg203,db.retry)
	endselect
	commit.transaction()
	|* secondo giro: imposto i nuovi valori dei campi non editabili, aggiornando in base al nome campo
	|* in questo modo evito problemi di attribuzione delle informazioni editabili al campo dovute per esempio
	|* a cancellazioni o nuovi inserimenti che spostano i campi e cambiano la posizione (chiave della tabella)
	db.retry.point()
	select  ttadv422.*
	from    ttadv422
	where   ttadv422._index1 = {:cpac,:cmod,:flno,:vers,:rele,:cust}
	and 	ttadv422._compnr = 0
	selectdo
		select  txamg203.*
		from    txamg203 for update
		where   txamg203._index1 = {:cbat,:sequ,:sseq,:ttadv422.fdno}
		selectdo
			txamg203.grou = txamg201.grou
			txamg203.dfil = txamg201.dfil
			imposta.campi.txamg203(pacc,vers,rele,cust)
			db.update(ttxamg203,db.retry)
		selectempty
			db.set.to.default(ttxamg203)
			txamg203.cbat = cbat
			txamg203.sequ = sequ
			txamg203.sseq = sseq
			txamg203.cpac = cpac
			txamg203.cmod = cmod
			txamg203.flno = flno
			txamg203.fdno = ttadv422.fdno
			txamg203.fdnm = ttadv422.fdnm
			txamg203.grou = txamg201.grou
			txamg203.dfil = txamg201.dfil
			imposta.campi.txamg203(pacc,vers,rele,cust)
			ret = db.insert(ttxamg203,db.retry,db.skip.dupl+db.return.error)
			commit.transaction()        				|TEMP!!!!!
		endselect
	selectempty
	endselect
	|* terza fase importo i campi della chiave (indice 1)
	select  ttadv421.*
	from    ttadv421
	where   ttadv421._index1 = {:cpac,:cmod,:flno,:vers,:rele,:cust,1}
	and 	ttadv421._compnr = 0
	as set with 1 rows
	selectdo
		i=1
		ppos=1
		repeat
			fdnm = ttadv421.part(1,i)
			select  ttadv422.comb
			from    ttadv422
			where   ttadv422._index1 = {:cpac,:cmod,:flno,:vers,:rele,:cust,:fdnm}
			and 	ttadv422._compnr = 0
			as set with 1 rows
			selectdo
				if ttadv422.comb = ttyeno.yes then
					select  ttadv423.*
					from    ttadv423
					where   ttadv423._index1 = {:cpac,:cmod,:flno,:vers,:rele,:cust,:fdnm}
					and 	ttadv423._compnr = 0
					order by ttadv423._index1 asc
					selectdo
						select  txamg203.*
						from    txamg203 for update
						where   txamg203._index2 = {:cbat,:sequ,:sseq,:ttadv423.chld}
						selectdo
							txamg203.pkey = tcyesno.yes
							db.update(ttxamg203,db.retry)
						endselect
					endselect
				else
					select  txamg203.*
					from    txamg203 for update
					where   txamg203._index1 = {:cbat,:sequ,:sseq}
					as set with 1 rows
					selectdo
						txamg203.pkey = tcyesno.yes
						db.update(ttxamg203,db.retry)
					endselect
				endif
			endselect
			i=i+1
		until i>24 or isspace(fdnm)
	selectempty
	endselect
	commit.transaction()
	|* quarta fase aggiungo i CDF
 	db.retry.point()
	|i CDF non hanno sequenza quindi li accodo manualmente sequenziandoli dal n°800
	max_fdno = 800
	select 	max(txamg203.fdno):max_fdno
	from 	txamg203
	where  	txamg203._index1 = {:cbat,:sequ,:sseq}
	selectdo
		if max_fdno < 800 then
			 max_fdno = 800
		else
			max_fdno = max_fdno +1
		endif
	selectempty
		 max_fdno = 800
	endselect
	|*
	select  ttadv491.*
	from    ttadv491
	where   ttadv491._index1 = {:pacc,:cpac,:cmod,:flno}
	and 	ttadv491._compnr = 0
	and	ttadv491.za_calc = ttyeno.no       |escludo i campi calcolati
	and	ttadv491.acti = ttyeno.yes         |escludo i campi non attivi
	and	ttadv491.avai = ttyeno.yes         |escludo i non disponiibli
	order by ttadv491._index1 asc
	selectdo
		select  txamg203.*
		from    txamg203 for update
		where   txamg203._index2 = {:cbat,:sequ,:sseq,:ttadv491.cfnm}
		selectdo
			txamg203.icdf = tcyesno.yes
			imposta.campi.txamg203(pacc,vers,rele,cust)
			ret = db.update(ttxamg203,db.retry)
		selectempty
			db.set.to.default(ttxamg203)
			txamg203.fdno = max_fdno
			txamg203.cbat = cbat
			txamg203.sequ = sequ
			txamg203.sseq = sseq
			txamg203.cpac = cpac
			txamg203.cmod = cmod
			txamg203.flno = flno
			txamg203.fdno = ttadv422.fdno
			txamg203.grou = txamg201.grou
			txamg203.dfil = txamg201.dfil
			txamg203.icdf = tcyesno.yes
			txamg203.fdnm = ttadv491.cfnm
			imposta.campi.txamg203(pacc,vers,rele,cust)
			ret = db.insert(ttxamg203,db.retry,db.skip.dupl)
		endselect
		ttadv422.fdno = ttadv422.fdno +1
	selectempty
	endselect
	commit.transaction()
	|* Suggest mappings to DataFile Fields based on setup if the link is not already in place
	db.retry.point()
	select  txamg203.*
	from    txamg203 for update
	where   txamg203._index1 = {:cbat,:sequ,:sseq}
	and	txamg203.grou = ""
	and	txamg203.dfil = ""
	and	txamg203.dfno = 0
	selectdo
		select  txamg111.*
		from    txamg111
		where   txamg111.cpac = :txamg203.cpac
		and	txamg111.cmod = :txamg203.cmod
		and	txamg111.flno = :txamg203.flno
		and	txamg111.rfnm = :txamg203.fdnm
		as set with 1 rows
		selectdo
			txamg203.grou = txamg111.grou
			txamg203.dfil = txamg111.dfil
			txamg203.dfno = txamg111.fdno
			txamg203.dnam = txamg111.fdnm
			db.update(ttxamg203,db.retry)
		endselect
	endselect
	commit.transaction()

}
function imposta.campi.txamg203(
 			 domain	ttaad.pacc	pacc
			,domain	ttadv.vers	vers
			,domain	ttadv.rele	rele
			,domain	ttadv.cust	cust
				)
{
	domain	ttadv.vers	dver
	domain	ttadv.rele	drel
	domain	ttadv.cust	dcus

	if txamg203.icdf = tcyesno.no then
		txamg203.fdno = ttadv422.fdno
		txamg203.comb = ltoe(etol(ttadv422.comb))
		txamg203.pacd = ttadv422.pacd
		txamg203.cdom = ttadv422.cdom
		txamg.dll0010.read.current.domain.definition(	txamg203.pacd, txamg203.cdom,
								dver, drel, dcus,
								txamg203.type, txamg203.digb, txamg203.diga)
		txamg203.iniv = ttadv422.iniv
		txamg203.rfpa = ttadv422.rfpa
		txamg203.rfmo = ttadv422.rfmo
		txamg203.rffn = ttadv422.rffn
		txamg203.rffd = ttadv422.rffd
		if ttadv422.dept  = 0 then
			txamg203.dept = 1
		else
			txamg203.dept = ttadv422.dept
		endif
		txamg203.refm = ltoe(etol(ttadv422.refm))

		if txamg203.mand = tcyesno.yes and txamg203.sele = tcyesno.yes then
			|si tiene il valore attuale, per gestire il caso in cui lo abbia flaggato manualmente
		else
			txamg203.mand = ltoe(etol(ttadv422.mand))
		endif
		txamg203.fdsc = tt.field.desc(txamg203.cpac&txamg203.cmod&txamg203.flno&"."&txamg203.fdnm)
		|* controllo se Ã¨ un campo multilanguage
		select  ttadv438.*
		from    ttadv438
		where   ttadv438._index1 = {:pacc,:txamg203.cpac,:txamg203.cmod,:txamg203.flno,:txamg203.fdnm}
		and	ttadv438.enab = ttyeno.yes
		and 	ttadv438._compnr = 0
		as set with 1 rows
		selectdo
			txamg203.isml = tcyesno.yes
		selectempty
			txamg203.isml = tcyesno.no
		endselect
	else	|* se si tratta di un CDF
		txamg203.comb = tcyesno.no
		txamg203.pacd = ttadv491.pacd
		txamg203.cdom = ttadv491.cdom
		if not isspace(ttadv491.cdom) then
			txamg.dll0010.read.current.domain.definition(txamg203.pacd,txamg203.cdom,
									dver,drel,dcus,
									txamg203.type,txamg203.digb,txamg203.diga)
		else
			|tbd
		endif
		txamg203.iniv = ttadv491.za_iniv
		txamg203.rfpa = ttadv491.rtap
		txamg203.rfmo = ttadv491.rtam
		txamg203.rffn = ttadv491.rtbl
		txamg203.rffd = ttadv491.rtaf
		if ttadv422.dept  = 0 then
			txamg203.dept = 1
		else
			txamg203.dept = ttadv491.dept
		endif
		txamg203.refm = ltoe(etol(ttadv491.rmod))

		if txamg203.mand = tcyesno.yes and txamg203.sele = tcyesno.yes then
			|si tiene il valore attuale, per gestire il caso in cui lo abbia flaggato manualmente
		else
			txamg203.mand = tcyesno.no
		endif
		if not isspace(ttadv491.cdes) then
			txamg203.fdsc = ttadv491.cdes
		else
			txamg203.fdsc = tt.label.desc(ttadv491.clab,ttadv.cont.general)
		endif
		txamg203.isml = ltoe(etol(ttadv491.mula))
	endif
}

function extern long txamg.dll0011.read.sequential.record(long fp, ref string buffer(), long lung)
{
        long ret
        long dummy

        ret = 0
	buffer = ""
        dummy = seq.gets(buffer, lung + 2, fp)
        if (dummy <> 0) and (not seq.eof(fp)) then |se c'è un errore e non è finito il file
                ret = 1
        endif

        return(ret)
}
function extern long txamg.dll0011.error.mess(long fp,domain tcmcs.str215 error.string)
{
	seq.puts(error.string,fp)
	return(0)
}
function extern long txamg.dll0011.check.access(domain  tcmcs.str215m src.file)
{

	return(0)
}
