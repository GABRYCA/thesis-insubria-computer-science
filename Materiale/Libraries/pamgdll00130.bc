#include <bic_desktop>
#include <bic_dam>
#include "itxadv0000"

#define dim_enum 3
#define dim_set  3
#define dim_date 8
#define dim_time 6
#define dim_text 10
#define dim_utcd 8
#define DATE_FORMAT "%D(%04Y%02m%02d)"
#define UTCD_FORMAT "%D(%02d%02m%04Y)"
#define UTCT_FORMAT "%U(%02h%02m%02s)"

	table	ttxadv000	|* Parameters
	table	ttxamg000	|* AlteaIN Migration Tool Parameters
	table	ttxamg100	|* Table Groups
	table	ttxamg110	|* DataFiles
	table	ttxamg111	|* DataFile Fields
	table	ttxamg200	|* Batch
	table	ttxamg201	|* BatchSequences
	table	ttxamg202	|* Target Tables
	table	ttxamg203	|* MappedFields

	table	tttadv115	|* Directories of Software Components
	table	tttadv230	|* Program Scripts
	table	tttadv400	|* Domains
	table	tttadv420	|* Table Definitions
	table	tttadv421	|* Table Indices
	table	tttadv422	|* Table Fields

	table	tttext000	|* Extensibility Parameters

	domain 	ttadv.cpac 	s.cpac
	domain 	ttadv.cmod 	s.cmod
	domain 	ttadv.cprs 	s.cprs
	domain	ttadv.vers	vers, d.vers
	domain	ttadv.rele	rele, d.rele
	domain	ttadv.cust	cust, d.cust

	domain	tcmcs.str215	script.path, test
		long	fp
		long 	lung_tot,rep
		long	ret
	domain txamg.cbat	cbat
	domain tcmcs.long 	sequ

function extern long txamg.dll0013.read.parameters()
{
	txadv.dll0012.read.parameters()
	select  txamg000.*
	from    txamg000
	where	txamg000._compnr = ADVCMP
	order by txamg000._index1
	as set with 1 rows
	selectdo
		return(true)
	endselect
	message("Parameters are not set!")
	return(false)
}

function extern txamg.dll0013.generate.process.script(  domain txamg.cbat i.cbat,
							domain tcmcs.long i.sequ)
{
	domain	tcyesno exis, modi

	cbat = i.cbat
	sequ = i.sequ

	txamg.dll0013.read.parameters()
	txamg.dll0010.read.current.pvrc(d.vers,d.rele,d.cust)
	|* verifico se è già indicato il codice del programma o se devo crearne uno nuovo
	select  txamg200.*
	from    txamg200
	where   txamg200._index1 = {:cbat}
	as set with 1 rows
	selectdo
		db.retry.point()
		select  txamg201.*
		from    txamg201 for update
		where   txamg201._index1 = {:cbat,:sequ}
		as set with 1 rows
		selectdo
			if txamg201.frzn = tcyesno.no then
				if isspace(txamg201.cprs) then
					select  txamg000.*
					from    txamg000 for update
					order by txamg000._index1
					as set with 1 rows
					selectdo
						txamg201.cprs = edit$(txamg000.prff,"99999999")
						txamg000.prff = txamg000.prff + 1
						db.update(ttxamg000,db.retry)
					endselect
				endif
				db.update(ttxamg201,db.retry)
				s.cpac = txamg000.prpk
				s.cmod = txamg000.prmd
				s.cprs = txamg201.cprs
				if not isspace(s.cpac) and not isspace(s.cmod) and not isspace(s.cprs) then
					txamg.dll0010.read.current.script.definition(	s.cpac, s.cmod ,s.cprs,
											vers, rele, cust, exis, modi)
				endif
			else
				message("Script "&trim$(txamg201.cprs)&" is frozen!")
				return
			endif
		selectempty
			message("Batch Sequence not found")
			return
		endselect
		commit.transaction()
	selectempty
		message("Batch Code not found")
		return
	endselect
	|* verifico se il programma puo' essere generato

	|* verifico se il programma e' stato modificato manualmente e in tal caso chiedo conferma
	if d.vers = vers and d.rele = rele and d.cust = cust then
	|se il VRC non e' quello di sviluppo allora non devo chiedere nulla
		if exis = tcyesno.yes then
			if modi = tcyesno.yes then
				|verifico se posso sovrascrivere
				if ask.enum("txamg.cprs.mod",tcyesno.no, s.cpac&s.cmod&s.cprs) = tcyesno.no then
				|* Library %1$s modified by user after
				|* generation, do you want to overwrite it?
					message("Script generation aborted by user")
					return
				endif
			endif
		else
			|chiedo se vuole crearne uno nuovo dato che non l'ho trovato
			if ask.enum("txamg.cprs.new",tcyesno.yes, s.cpac&s.cmod&s.cprs) = tcyesno.no then
			|* Library %1$s not found, do yu wnat to create it?
				message("Script generation aborted by user")
				return
			endif
		endif
	endif
	|* genero ll sorgente
	refresh.library()
	generate.library.file(cbat,sequ)
	|* end of generation process
}
function refresh.library()
{
	domain	tcncmp start.comp

	start.comp = get.compnr()
	switch.to.company(0)
	db.retry.point()
	select  ttadv230.*
	from    ttadv230 for update
	where   ttadv230._index1 = {:s.cpac,:s.cmod,:s.cprs,:d.vers,:d.rele,:d.cust}
	and	ttadv230._compnr = 0
	selectdo
		dal.change.object("ttadv230")
		dal.set.field("ttadv230.desc",trim$(txamg201.cbat)&"-"&edit$(txamg201.sequ,"999"))
|		dal.set.field("ttadv230.crus",logname$)
|		dal.set.field("ttadv230.crdt",utc.num())
|		dal.set.field("ttadv230.ptyp",etol(ttadv.styp.library))
|		dal.set.field("ttadv230.expi", etol(ttyeno.no))
|		dal.set.field("ttadv230.vari(1)", 1)
		dal.set.field("ttadv230.upus(1,1)", logname$)
		dal.set.field("ttadv230.updt(1)", utc.num())
|		dal.set.field("ttadv230.uptm(1)", 0)
|		dal.set.field("ttadv230.xc_btiv", 2350)
		dal.save.object("ttadv230",db.retry)
	selectempty
		dal.new.object("ttadv230")
		dal.set.field("ttadv230._compnr",0)
		dal.set.field("ttadv230.cpac", s.cpac)
		dal.set.field("ttadv230.cmod", s.cmod)
		dal.set.field("ttadv230.cprs", s.cprs)
		dal.set.field("ttadv230.vers", d.vers)
		dal.set.field("ttadv230.rele", d.rele)
		dal.set.field("ttadv230.cust", d.cust)
		dal.set.field("ttadv230.desc",trim$(txamg201.cbat)&"-"&edit$(txamg201.sequ,"999"))
		dal.set.field("ttadv230.crus", logname$)
		dal.set.field("ttadv230.crdt", utc.num())
		dal.set.field("ttadv230.ptyp", etol(ttadv.styp.library))
		dal.set.field("ttadv230.expi", etol(ttyeno.no))
		dal.set.field("ttadv230.vari(1)", 1)
|		dal.set.field("ttadv230.upus(1,1)", "")
|		dal.set.field("ttadv230.updt(1)", 0)
|		dal.set.field("ttadv230.uptm(1)", 0)
|		dal.set.field("ttadv230.xc_btiv", 2350)
		dal.save.object("ttadv230",db.retry)
	endselect
	commit.transaction()
	switch.to.company(start.comp)
}
function void generate.library.file(  	domain txamg.cbat i.cbat,
					domain tcmcs.long i.sequ)
{
	domain	ttaad.pacc	pacc
	long inizio, fine
	domain	tcmcs.str215	script.bse.name

	|* purtroppo gli ambienti cloud non supportano la scrittura diretta
	|* dello scrpit, quindi occorre ricopiarlo a manina da LN Studio
	|* verifico quindi prima di tutto se siamo in cloud

	pacc = curr.pacc$
	select	ttext000.*
	from	ttext000
	where   ttext000._index1 = {:pacc}
	and 	ttext000._compnr = 0
	as set with 1 rows
	selectdo
		if ttext000.erfc = ttyeno.yes then
			|script.path = creat.tmp.file$(bse.tmp.dir$())
			script.path = "${BSE}\appdata\migscript_"&s.cpac&s.cmod&trim$(s.cprs)&".txt"
			|* cancello il file
			file.rm(script.path)
			|* lo riapro per popolarlo
			fp = seq.open(script.path,"w")
			|* creo la library in base alle scelte impostate
			generate.library(i.cbat,i.sequ)
			|* posso richiuderlo
			seq.close(fp)
			client.show.file(script.path
					,true
					,"migscript_"&s.cpac&s.cmod&trim$(s.cprs))
		else
			|TBD
		endif
	endselect
}
function generate.library(  domain txamg.cbat cbat,
			    domain tcmcs.long sequ)
{
	domain tcmcs.str8 tabella

	select  txamg201.*,txamg110.*
	from    txamg201,txamg110
	where   txamg201._index1 = {:cbat,:sequ}
	and	txamg201.cmbb refers to txamg110
	selectdo
       		GeneraDich()
	endselect
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
		|* ciclo su tutte le tabelle target della sequenza
		tabella = txamg202.cpac&txamg202.cmod&txamg202.flno
    		GeneraDichImport(tabella)
	endselect
    	Riga("|****************************** FUNCTION SECTION ***************************************")
    	Riga("|****************************** PUBLIC FUNCTIONS ***************************************")
	GeneraProcessImportFile()
	GeneraProcessDatafile()
    	Riga("|****************************** PRIVATE FUNCTIONS ***************************************")
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
		|* ciclo su tutte le tabelle target della sequenza
		tabella = txamg202.cpac&txamg202.cmod&txamg202.flno
		GeneraMap(tabella)
		GeneraProcess(tabella)
		GeneraProcessRecord(tabella)
		GeneraCheckRecord(tabella)
	endselect
}
function GeneraDich()
{
	string datafile(41)
	string tabella(8)
	datafile = trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)
    Riga("|******************************************************************************************")
    Riga("|* Import "&trim$(txamg201.cbat)&"-"&edit$(txamg201.sequ,"999"))
    Riga("|* "&s.cpac&s.cmod&s.cprs&"")
    Riga("|*")
    Riga("|*                                           Copyright ALTEA S.r.L.")
    Riga("|*                                           Written by Roberto Bevacqua")
    Riga("|****************************** DECLARATION SECTION ***************************************")
    Riga("|****************************** COMMON DECLARATIONS ***************************************")
    Riga("#include <bic_dam>")
    Riga("#include ""i"&txamg000.lopk&txamg000.lomd&trim$(txamg110.cprs)&"""")
    Riga("#pragma used dll ""otxamgdll0011""")
    Riga("#pragma used dll ""o"&txamg000.lopk&txamg000.lomd&trim$(txamg110.cprs)&"""")
    Riga("")
    Riga("     extern  domain  tcmcs.long  record."&datafile&"    |numero record elaborati")
    Riga("     extern  domain  tcmcs.long  scartati."&datafile&"    |numero record scartati")
    Riga("")
    Riga("             domain  tcncmp curr.comp")
    Riga("")
}
function GeneraDichImport(domain tcmcs.str8 tabella)
{
	string datafile(41)
	datafile = trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)
    Riga("|****************************** IMPORT DECLARATIONS ***************************************")

    Riga("                     long        insert_update."&tabella)
    Riga("")
lung_tot = 0
select  txamg203.*
from    txamg203
where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
and	txamg203.comb=tcyesno.no
and	txamg203.sele=tcyesno.yes
order by txamg203.fdno
selectdo
	if txamg203.icdf = tcyesno.yes then
		txamg203.fdnm = "cdf_"&txamg203.fdnm
	endif
	for rep = 1 to txamg203.dept
		on case txamg203.type
		case txamg.type.byte:
		case txamg.type.integer:
		case txamg.type.long:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + txamg203.digb+txamg203.diga + 1
			break
		case txamg.type.float:
		case txamg.type.double:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + txamg203.digb+txamg203.diga + 1
			break
		case txamg.type.string:
		case txamg.type.string.mb:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + txamg203.digb+txamg203.diga + 1
			break
		case txamg.type.enumerated:
		case txamg.type.set:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + dim_set  + 1
			break
		case txamg.type.date:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + dim_date + 1
			break
		case txamg.type.utc_date:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    " & trim$(txamg203.pacd&txamg203.cdom) & "     " &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + dim_utcd + 1
			break
		case txamg.type.text:
			if txamg203.dept > 1 then
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
    Riga("     domain    tcmcs.long" &tabella& trim$(txamg203.fdnm) & "(" & str$(txamg203.dept) & ")")
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "_" & str$(txamg203.dept) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			else
|    Riga("     domain    tcmcs.long" & "     lung." & trim$(txamg203.fdnm))
    Riga("     domain    tcmcs.long" &tabella& trim$(txamg203.fdnm))
|    Riga("     string    imp.str." & trim$(txamg203.fdnm) & "(" & str$(txamg203.digb+txamg203.diga+1) & ")" )
			endif
			lung_tot = lung_tot + dim_text + 1
			break
		default:
			message("Domain type "&enum.descr$("txamg.type",txamg203.type)&" not supported!")
			|* Domain Type
		endcase
	endfor
selectempty
endselect
}
function void GeneraProcessImportFile()
{
	string datafile(41)
	string tabella(8)
	datafile = trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)
    Riga("function extern long "&s.cpac&s.cmod&"."&trim$(s.cprs)&".process.import.file"&"."&datafile&"()")
    Riga("{")
    Riga("	long ret")
    Riga("	long err.num")
    Riga("	string str.err(255)")
    Riga("	string nome.error.file(55)")
    Riga("")
    Riga("	curr.comp = get.compnr()")
    Riga("	record."&datafile&" = 0")
    Riga("	scartati."&datafile&" = 0")
    Riga("")
    Riga("	txamg.dll0011.log.start.datafile(txamg300.cbat,txamg300.runs,1)")
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
    Riga("	txamg.dll0011.log.start.table(txamg300.cbat,txamg300.runs,"&str$(txamg201.sequ)&","&str$(txamg202.sseq)&")")
	endselect
    Riga("")
    riga("	ret = "&txamg000.lopk&txamg000.lomd&"."&trim$(txamg110.cprs)&".check.file."&trim$(datafile)&"(txamg300.cbat,txamg300.runs,txamg301.sequ)")
    Riga("	|* Apertura del file dei dati")
    Riga("	fpdat."&trim$(datafile)&" = seq.Open(path.file."&trim$(datafile)&",""r"")")
    Riga("	if ret = OK and fpdat."&trim$(datafile)&" > 0 then")
    Riga("		|* Ciclo per la lettura del file")
    Riga("		while not seq.eof(fpdat."&trim$(datafile)&")")
    Riga("			record."&datafile&" = record."&datafile&"+1")
    Riga("			|* Lettura del record")
    Riga("			ret = txamg.dll0011.read.sequential.record(fpdat."&datafile&", buffer_"&datafile&", lung."&datafile&")")
    Riga("			if ret = ERRORE then")
    Riga("			 	scartati."&datafile&" = scartati."&datafile&" +1")
    Riga("	      		endif")
    Riga("			ret = process."&datafile&"()")
    Riga("			if ret = ERRORE then")
    Riga("			 	scartati."&datafile&" = scartati."&datafile&" +1")
    Riga("	      		endif")
    Riga("		endwhile")
    Riga("	endif")
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
    Riga("	txamg.dll0011.log.end.table(txamg300.cbat,txamg300.runs,"&str$(txamg201.sequ)&","&str$(txamg202.sseq)&")")
	endselect
	select  txamg201.*
	from    txamg201
	where   txamg201._index1 = {:cbat,:sequ}
	order by txamg201._index1
	selectdo
    Riga("	txamg.dll0011.log.end.datafile(txamg300.cbat,txamg300.runs,"&str$(txamg201.sequ)&",record."&datafile&",record."&datafile&"-scartati."&datafile&",scartati."&datafile&")")
	endselect
    Riga("	if fpdat."&datafile&">0 then")
    Riga("		ret = seq.close(fpdat."&datafile&")")
    Riga("	endif")
    Riga("	return(OK)")
    Riga("}")
}
function void GeneraProcessDatafile()
{
    string datafile(41)
    string tabella(8)
    datafile = trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)

    Riga("function long process."&datafile&"()")
    Riga("{")
    Riga("	long ret")
    Riga("	string str.err(255)")
    Riga("")
    Riga("	ret = "&txamg000.lopk&txamg000.lomd&"."&trim$(txamg110.cprs)&".unpack."&datafile&"(txamg300.cbat,txamg300.runs,txamg301.sequ,txamg302.sseq)")
    Riga("	if ret = ERRORE then")
    Riga("		return(ret)")
    Riga("	endif")
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
		tabella = txamg202.cpac&txamg202.cmod&txamg202.flno
    Riga("	ret = map."&tabella&".record()")
    Riga("	if ret = ERRORE then")
    Riga("		return(ret)")
    Riga("	endif")
	endselect
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
		tabella = txamg202.cpac&txamg202.cmod&txamg202.flno
    Riga("	ret = check."&tabella&".record()")
    Riga("	if ret = ERRORE then")
    Riga("		return(ret)")
    Riga("	endif")
	endselect
    Riga("	db.retry.point()")
	select  txamg202.*,txamg201.*
	from    txamg202, txamg201
	where   txamg202._index1 = {:cbat,:sequ}
	and	txamg201._index1 = {:cbat,:sequ}
	order by txamg202._index1
	selectdo
		tabella = txamg202.cpac&txamg202.cmod&txamg202.flno
    Riga("	ret = process."&tabella&"()")
    Riga("	if ret = OK then")
    Riga("		commit.transaction()")
    Riga("	else")
    Riga("  		abort.transaction()")
    Riga("  		str.err = ""Database or DAL error""")
    Riga("  		txamg.dll0011.log.error(txamg302.cbat,txamg302.runs,txamg302.sequ,txamg302.sseq,record."&datafile&",ret,str$(str.err))")
    Riga("  	endif")
	endselect
    Riga("	return(ret)")
    Riga("}")
}
function void GeneraMap(domain tcmcs.str8 tabella)
{
    Riga("function long map."&tabella&".record()")
    Riga("{")
	select  txamg203.*, txamg111.*
	from    txamg203, txamg111
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.cmbd refers to txamg111
	and	txamg203.comb=tcyesno.no
	and	txamg203.sele=tcyesno.yes
	order by txamg203.fdno, txamg203.fdno
	selectdo
		if txamg203.icdf = tcyesno.yes then
			txamg203.fdnm = "cdf_"&txamg203.fdnm
		endif
		for rep = 1 to txamg203.dept
			on case txamg203.type
			case txamg.type.byte:
			case txamg.type.integer:
			case txamg.type.long:
				if txamg203.dept > 1 then
    Riga("	"&tabella&trim$(txamg203.fdnm)&"_"&str$(txamg203.dept)&" = "&"lval(imp.str."&trim$(txamg111.fdnm)&"("&str$(txamg203.dept)&"))")
				else
					on case txamg203.mapl
					case txamg.mapl.default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"lval("&trim$(txamg203.logi)&")")
						break
					case txamg.mapl.library:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&trim$(txamg203.logi))
						break
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"lval(imp.str."&trim$(txamg203.fdnm)&")")
					endcase
				endif
				break
			case txamg.type.float:
			case txamg.type.double:
				if txamg203.dept > 1 then
    Riga("	"&tabella&trim$(txamg203.fdnm)&"_"&str$(txamg203.dept)&" = "&"val(imp.str."&trim$(txamg111.fdnm)&"("&str$(txamg203.dept)&"))")
				else
					on case txamg203.mapl
					case txamg.mapl.default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"val("&trim$(txamg203.logi)&")")
						break
					case txamg.mapl.library:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&trim$(txamg203.logi))
						break
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"val(imp.str."&trim$(txamg203.fdnm)&")")
					endcase
				endif
				break
			case txamg.type.string:
			case txamg.type.string.mb:
				if txamg203.dept > 1 then
    Riga("	dummy = tt.align.according.domain(imp.str."&trim$(txamg111.fdnm)&"_"&str$(txamg203.dept)&","&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&"),"""&txamg203.pacd&trim$(txamg203.cdom)&""")")
				else
					on case txamg203.mapl
					case txamg.mapl.default:
					case txamg.mapl.library:
    Riga("	dummy = tt.align.according.domain("&trim$(txamg203.logi)&","&tabella&trim$(txamg203.fdnm)&","""&txamg203.pacd&trim$(txamg203.cdom)&""")")
						break
					default:
    Riga("	dummy = tt.align.according.domain(imp.str."&trim$(txamg111.fdnm)&","&tabella&trim$(txamg203.fdnm)&","""&txamg203.pacd&trim$(txamg203.cdom)&""")")
					endcase
				endif
				break
			case txamg.type.enumerated:
			case txamg.type.set:
				if txamg203.dept > 1 then
    Riga("	"&tabella&trim$(txamg203.fdnm)&"_"&str$(txamg203.dept)&" = "&"imp.str."&trim$(txamg111.fdnm)&"("&str$(txamg203.dept)&")")
				else
	       				on case txamg203.mapl
					case txamg.mapl.default:
					case txamg.mapl.library:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&trim$(txamg203.logi))
						break
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"imp.str."&trim$(txamg111.fdnm))
					endcase
				endif
				break
			case txamg.type.date:
				if txamg203.dept > 1 then
    Riga("	|*DA SISTEMARE!")
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.date(imp.str."&trim$(txamg111.fdnm)&","""&DATE_FORMAT&""")")
				else
       					on case txamg203.mapl
					case txamg.mapl.default:
					case txamg.mapl.library:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.date("&trim$(txamg203.logi)&","""&DATE_FORMAT&""")")
						break
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.date(imp.str."&trim$(txamg111.fdnm)&","""&DATE_FORMAT&""")")
					endcase
				endif
				break
			case txamg.type.utc_date:
				if txamg203.dept > 1 then
    Riga("	|*DA SISTEMARE!")
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.utc(imp.str."&trim$(txamg111.fdnm)&"(1;"&str$(dim_date)&"),"""&UTCD_FORMAT&""",imp.str."&trim$(txamg111.fdnm)&"("&str$(dim_date+1)&";"&str$(dim_time)&"),"""&UTCT_FORMAT&""")")
				else
       					on case txamg203.mapl
					case txamg.mapl.default:
					case txamg.mapl.library:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.utc("&trim$(txamg203.logi)&"(1;"&str$(dim_date)&"),"""&UTCD_FORMAT&""","&trim$(txamg203.logi)&"("&str$(dim_date+1)&";"&str$(dim_time)&"),"""&UTCT_FORMAT&""")")
						break
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = inputstr.to.utc(imp.str."&trim$(txamg111.fdnm)&"(1;"&str$(dim_date)&"),"""&UTCD_FORMAT&""",imp.str."&trim$(txamg111.fdnm)&"("&str$(dim_date+1)&";"&str$(dim_time)&"),"""&UTCT_FORMAT&""")")
					endcase
				endif
				break
			case txamg.type.text:
    Riga("	|*DA SISTEMARE!")
				if txamg203.dept > 1 then
    Riga("	"&tabella&trim$(txamg203.fdnm)&"_"&str$(txamg203.dept)&" = "&"val(imp.str."&trim$(txamg111.fdnm)&"("&str$(txamg203.dept)&"))")
				else
       					on case txamg203.mapl
					case txamg.mapl.default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"val("&trim$(txamg203.logi)&")")
						break
					case txamg.mapl.library:
						break
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&trim$(txamg203.logi))
					default:
    Riga("	"&tabella&trim$(txamg203.fdnm)&" = "&"val(imp.str."&trim$(txamg111.fdnm)&")")
					endcase
				endif
				break
			default:
				message("Domain type "&enum.descr$("txamg.type",txamg203.type)&" not supported!")
				|* Domain Type
			endcase
		endfor
	endselect
    Riga(" 	return(OK)")
    Riga("}")
}
function void GeneraProcess(domain tcmcs.str8 tabella)
{
	string condizione(5)

    Riga("function long process."&tabella&"()")
    Riga("{")
    Riga("	select  "&tabella&".*")
    Riga("	from	"&tabella&" for update")
|* INSERIMENTO DELLA WHERE CLAUSE
	condizione = "where"
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.pkey=tcyesno.yes
	and	txamg203.sele=tcyesno.yes
	order by txamg203.fdno
	selectdo
    Riga("	"&condizione&"	"&tabella&"."&trim$(txamg203.fdnm)&" = :"&tabella&trim$(txamg203.fdnm))
		condizione = "  and"
	endselect
    Riga("	as set with 1 rows")
    Riga("	selectdo")
    Riga("		dal.change.object("""&tabella&""")")
    Riga("		insert_update."&tabella&" = 1")
    Riga("		ret = process."&tabella&".record()")
    Riga("		if ret = OK then")
    Riga("			ret = dal.save.object("""&tabella&""",db.retry)")
    Riga("	       endif")
    Riga("	selectempty")
    Riga(" 		dal.new.object("""&tabella&""")")
    Riga(" 		insert_update."&tabella&" = 0")
    Riga("	        ret = process."&tabella&".record()")
    Riga("		if ret = OK then")
    Riga("			ret = dal.save.object("""&tabella&""",db.retry)")
    Riga("		endif")
    Riga("	endselect")
    Riga(" 	return(ret)")
    Riga("}")
}
function void GeneraProcessRecord(domain tcmcs.str8 tabella)
{
    Riga("function long process."&tabella&".record()")
    Riga("{")
    Riga("	long ret")
    Riga("	long err.num")
    Riga("	string str.err(255)")
    Riga("	if insert_update."&tabella&" = 0 then")
    Riga("		|* imposto i campi chiave")
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.pkey=tcyesno.yes
	and	txamg203.sele=tcyesno.yes
	order by txamg203.fdno
	selectdo
    Riga("		dal.set.field("""&tabella&"."&trim$(txamg203.fdnm)&""","&tabella&trim$(txamg203.fdnm)&")")
	endselect
    Riga("	endif")
    Riga("	|* imposto i campi non chiave")
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.pkey=tcyesno.no
	and	txamg203.sele=tcyesno.yes
	order by txamg203.fdno
	selectdo
	if txamg203.icdf = tcyesno.yes then
		txamg203.fdnm = "cdf_"&txamg203.fdnm
	endif
    Riga("	dal.set.field("""&tabella&"."&trim$(txamg203.fdnm)&""","&tabella&trim$(txamg203.fdnm)&")")
	endselect
    Riga("")
    Riga("	|* imposto i campi ai default richiesti")
    Riga("")
    Riga(" 	return(OK)")
    Riga("}")
}
function void GeneraCheckRecord(domain tcmcs.str8 tabella)
{
	string datafile(41)
	datafile = trim$(txamg201.grou)&"_"&trim$(txamg201.dfil)

    Riga("function long check."&tabella&".record()")
    Riga("{")
    Riga(" 	domain  tcmcs.long  mia.data, dummy")
    Riga("	long 	ret")
    Riga("")
    Riga("	ret = OK")
    Riga("")
    Riga(" |*")
    Riga(" |* controllo campi obbligatori")
    Riga(" |*")
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.comb=tcyesno.no
	and	txamg203.sele=tcyesno.yes
	and	txamg203.mand=tcyesno.yes
	order by txamg203.fdno, txamg203.fdno
	selectdo
		if txamg203.icdf = tcyesno.yes then
			txamg203.fdnm = "cdf_"&txamg203.fdnm
		endif
		for rep = 1 to txamg203.dept
			on case txamg203.type
			case txamg.type.byte:
			case txamg.type.integer:
			case txamg.type.long:
				if txamg203.dept > 1 then
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&")=0 then")
				else
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"=0 then")
				endif
				break
			case txamg.type.float:
			case txamg.type.double:
				if txamg203.dept > 1 then
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&")=0.0 then")
				else
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"=0.0 then")
				endif
				break
			case txamg.type.string:
			case txamg.type.string.mb:
				if txamg203.dept > 1 then
    Riga(" if isspace("&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&") then")
				else
    Riga(" if isspace("&tabella&trim$(txamg203.fdnm)&") then")
				endif
				break
			case txamg.type.enumerated:
			case txamg.type.set:
				if txamg203.dept > 1 then
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&")=empty then")
				else
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"=empty then")
				endif
				break
			case txamg.type.date:
			case txamg.type.utc_date:
	       		case txamg.type.text:
				if txamg203.dept > 1 then
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"("&str$(txamg203.dept)&")=0 then")
				else
    Riga(" if "&tabella&trim$(txamg203.fdnm)&"=0 then")
				endif
				break
 			default:
			endcase
    Riga("     txamg.dll0011.log.error(txamg302.cbat,txamg302.runs,txamg302.sequ,txamg302.sseq,record."&datafile&",ret,""campo "&tabella&trim$(txamg203.fdnm)&" obbligatorio"")")
    Riga("     ret=ERRORE")
    Riga(" endif")
		endfor
	endselect
    Riga(" |*")
    Riga(" |* controllo referenze mandatory")
    Riga(" |*")
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.comb=tcyesno.no
	and	txamg203.sele=tcyesno.yes
	and	txamg203.refm = txamg.refm.compulsory
	order by txamg203.fdno, txamg203.fdno
	selectdo
		if txamg203.icdf = tcyesno.yes then
			txamg203.fdnm = "cdf_"&txamg203.fdnm
		endif
    Riga(" select  "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&".*")
    Riga(" from    "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn)
    Riga(" where   "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&"."&trim$(txamg203.rffd)&" = :"&tabella&trim$(txamg203.fdnm))
    Riga(" as set with 1 rows")
    Riga(" selectdo")
    Riga(" selectempty")
    Riga("    	txamg.dll0011.log.error(txamg302.cbat,txamg302.runs,txamg302.sequ,txamg302.sseq,record."&datafile&",ret,""referenza a:""&"&tabella&trim$(txamg203.fdnm)&"&"" mancante, tabella "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&""")")
    Riga(" 	ret=ERRORE")
    Riga(" endselect")
	endselect
    Riga(" |*")
    Riga(" |* controllo referenze mandatory unless")
    Riga(" |*")
	select  txamg203.*
	from    txamg203
	where   txamg203._index1 = {:txamg202.cbat, :txamg202.sequ, :txamg202.sseq}
	and	txamg203.comb=tcyesno.no
	and	txamg203.sele=tcyesno.yes
	and	txamg203.refm = txamg.refm.unless.empty
	order by txamg203.fdno, txamg203.fdno
	selectdo
		if txamg203.icdf = tcyesno.yes then
			txamg203.fdnm = "cdf_"&txamg203.fdnm
		endif
    Riga(" select  "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&".*")
    Riga(" from    "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn)
    Riga(" where   "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&"."&trim$(txamg203.rffd)&" = :"&tabella&trim$(txamg203.fdnm))
    Riga(" as set with 1 rows")
    Riga(" selectdo")
    Riga(" selectempty")
    Riga("    	txamg.dll0011.log.error(txamg302.cbat,txamg302.runs,txamg302.sequ,txamg302.sseq,record."&datafile&",ret,""referenza a:""&"&tabella&trim$(txamg203.fdnm)&"&"" mancante, tabella "&txamg203.rfpa&txamg203.rfmo&txamg203.rffn&""")")
    Riga(" 	ret=ERRORE")
    Riga(" endselect")
	endselect
    Riga(" return(ret)")
    Riga("}")
}


function void Riga(domain tcmcs.s999 statement.line)
{
	seq.puts(statement.line,fp)
}
