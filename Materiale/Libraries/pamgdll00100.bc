|******************************************************************************
|* Script Type: Library
|******************************************************************************


	table	tttadv040	|* Current Package Version by User
	table	tttadv111	|* Package VRC's
	table	tttadv112	|* Package VRCs in Package Combination (Runtime)
	table	tttadv140	|* Labels by Package VRC
	table	tttadv230	|* Program Scripts
	table	tttadv400	|* Domains
	table	tttadv420	|* Table Definitions
	table	tttadv421	|* Table Indices
	table	tttadv422	|* Table Fields

function extern long txamg.dll0010.read.current.table.definition(
			domain ttadv.cpac cpac,
			domain ttadv.cmod cmod,
			domain ttadv.flno flno,
		ref	domain ttadv.vers vers,
		ref 	domain ttadv.rele rele,
		ref 	domain ttadv.cust cust,
		ref	domain tcdsca name)
{
	if read.current.pvrc() then
		return(txamg.dll0010.read.current.table.pvrc(	ttadv040.vers, ttadv040.rele, ttadv040.cust,
								cpac, cmod, flno, vers, rele, cust, name)
			)
	endif
	return(false)
}
function extern long txamg.dll0010.read.current.table.pvrc(
	       			domain ttadv.vers start.vers,
				domain ttadv.rele start.rele,
				domain ttadv.cust start.cust,
				domain ttadv.cpac cpac,
				domain ttadv.cmod cmod,
				domain ttadv.flno flno,
			ref	domain ttadv.vers vers,
			ref 	domain ttadv.rele rele,
			ref 	domain ttadv.cust cust,
			ref	domain tcdsca dsca
			)
{
	long 	i	|pointer to VRC derivation element
	domain	tcclan		clan
	domain	ttaad.pacc	pacc

	clan = language$
	pacc = curr.pacc$

	select	ttadv112.*
	from 	ttadv112
	where	ttadv112._index1 = {:pacc,:cpac,1}
	and	ttadv112._compnr = 0
	selectdo
		select  ttadv111.*
		from    ttadv111
		where   ttadv111._index1 = {:cpac,:ttadv112.vers,:ttadv112.rele,:ttadv112.cust}
		and	ttadv111._compnr = 0
		selectdo
			for i = 1 to 40
				vers = ttadv111.tver(1,i)
				rele = ttadv111.trel(1,i)
				cust = ttadv111.tcus(1,i)
				select  ttadv420.*
				from    ttadv420
				where   ttadv420._index1 = {:cpac,:cmod,:flno,:vers,:rele,:cust}
				and	ttadv420._compnr = 0
				as set with 1 rows
				selectdo
					select  ttadv140.*
					from    ttadv140
					where   ttadv140._index1 = {:clan,:ttadv420.cpac,:ttadv420.zb_clab}
					and	ttadv140._compnr = 0
					order by ttadv140._index1 desc
					as set with 1 rows
					selectdo
						dsca = ttadv140.desc
					selectempty
						dsca = ""
					endselect
					return(true)
				endselect
			endfor
		endselect
	endselect
	return(false)
}
function extern long txamg.dll0010.read.current.pvrc(	ref domain ttadv.vers vers,
							ref domain ttadv.rele rele,
							ref domain ttadv.cust cust)
{
	if read.current.pvrc() then
		vers = ttadv040.vers
		rele = ttadv040.rele
		cust = ttadv040.cust
		return(true)
	else
		return(false)
	endif
}
function long read.current.pvrc()
{
        domain  tclogn  logn

        logn = logname$

        select  ttadv040.*
        from    ttadv040
        where   ttadv040._index1 = {:logn}
	and	ttadv040._compnr = 0
        selectdo
		return(true)
        endselect
	return(false)
}
function extern long txamg.dll0010.read.current.domain.pvrc(
	       			domain ttadv.vers start.vers,
				domain ttadv.rele start.rele,
				domain ttadv.cust start.cust,
				domain ttadv.cpac cpac,
				domain ttadv.cdom cdom,
			ref	domain ttadv.vers vers,
			ref 	domain ttadv.rele rele,
			ref 	domain ttadv.cust cust,
			ref	domain txamg.type type,
			ref	domain ttadv.ndig digb,
			ref	domain ttadv.ndig diga)
{
	long 	i	|pointer to VRC derivation element
	domain	tcclan		clan
	domain	ttaad.pacc	pacc

	clan = language$
	pacc = curr.pacc$

	select	ttadv112.*
	from 	ttadv112
	where	ttadv112._index1 = {:pacc,:cpac,1}
	and	ttadv112._compnr = 0
	selectdo
		select  ttadv111.*
		from    ttadv111
		where   ttadv111._index1 = {:cpac,:ttadv112.vers,:ttadv112.rele,:ttadv112.cust}
		and	ttadv111._compnr = 0
		selectdo
			for i = 1 to 40
				vers = ttadv111.tver(1,i)
				rele = ttadv111.trel(1,i)
				cust = ttadv111.tcus(1,i)
				select  ttadv400.*
				from    ttadv400
				where   ttadv400._index1 = {:cpac,:cdom,:vers,:rele,:cust}
				and	ttadv400._compnr = 0
				as set with 1 rows
				selectdo
					type = ltoe(etol(ttadv400.type))
					digb = ttadv400.digb + ttadv400.leng + ttadv400.lene
					diga = ttadv400.diga
					return(true)
				endselect
			endfor
		endselect
	endselect
	vers = ""
	rele = ""
	cust = ""
	type = empty
	digb = 0
	diga = 0
	return(false)
}
function extern long txamg.dll0010.read.current.domain.definition(
			domain ttadv.cpac cpac,
			domain ttadv.cdom cdom,
		ref	domain ttadv.vers vers,
		ref 	domain ttadv.rele rele,
		ref 	domain ttadv.cust cust,
		ref	domain txamg.type type,
		ref	domain ttadv.ndig digb,
		ref	domain ttadv.ndig diga)
{
	if read.current.pvrc() then
		return(txamg.dll0010.read.current.domain.pvrc(	ttadv040.vers, ttadv040.rele, ttadv040.cust,
								cpac, cdom, vers, rele, cust, type, digb, diga)
			)
	endif
	return(false)
}
function extern long txamg.dll0010.read.current.script.pvrc(
	       			domain ttadv.vers start.vers,
				domain ttadv.rele start.rele,
				domain ttadv.cust start.cust,
				domain ttadv.cpac cpac,
				domain ttadv.cmod cmod,
				domain ttadv.cprs cprs,
			ref	domain ttadv.vers vers,
			ref 	domain ttadv.rele rele,
			ref 	domain ttadv.cust cust,
			ref	domain tcyesno	  exis,
			ref	domain tcyesno	  modi)
{
	long 	i	|pointer to VRC derivation element
	domain	tcclan		clan

	clan = language$

	select  ttadv111.*
	from    ttadv111
	where   ttadv111._index1 = {:cpac,:start.vers,:start.rele,:start.cust}
	and	ttadv111._compnr = 0
	selectdo
		exis = tcyesno.no |parto assumento che non l'ho trovato
		modi = tcyesno.no |e che quindi non è stato nemmeno modificato
		for i = 1 to 40
			vers = ttadv111.tver(1,i)
			rele = ttadv111.trel(1,i)
			cust = ttadv111.tcus(1,i)
			select  ttadv230.*
			from    ttadv230
			where   ttadv230._index1 = {:cpac,:cmod,:cprs,:vers,:rele,:cust}
			and	ttadv230._compnr = 0
			as set with 1 rows
			selectdo
				exis = tcyesno.yes
				if ttadv230.updt(1) >0 then
					modi = tcyesno.yes
				endif
				return(true)
			endselect
		endfor
	endselect
	vers = ""
	rele = ""
	cust = ""
	modi = tcyesno.no
	exis = tcyesno.no
	return(false)
}
function extern long txamg.dll0010.read.current.script.definition(
			domain ttadv.cpac cpac,
			domain ttadv.cmod cmod,
			domain ttadv.cprs cprs,
		ref	domain ttadv.vers vers,
		ref 	domain ttadv.rele rele,
		ref 	domain ttadv.cust cust,
		ref	domain tcyesno	  exis,
		ref	domain tcyesno	  modi)
{
	if read.current.pvrc() then
		return(txamg.dll0010.read.current.script.pvrc(	ttadv040.vers, ttadv040.rele, ttadv040.cust,
								cpac, cmod, cprs, vers, rele, cust,
								exis, modi)
			)
	endif
	return(false)
}
function extern long txamg.dll0010.read.sequential.record(long fp, ref string buffer(), long lung, long fperr)
{
        long ret
        long dummy

        ret = true
        dummy = seq.gets(buffer, lung + 2, fp)
        if (dummy <> 0) and (not seq.eof(fp)) then |if there are no errore and we haven't reached end of file
                ret = false
        endif

        return (ret)
}
