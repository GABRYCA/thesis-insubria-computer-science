|******************************************************************************
|* txadv000  0  VRC B61O a  ext
|* Dal for txamg000
|* rbevacqu
|* 22-08-09 [09:15]
|******************************************************************************
|* Script Type: DAL
|******************************************************************************

	table	ttxamg000		|* Parameters

	#include <bic_dal2>
	|#include "itcmcs2000"		|* DAL(-GUI) Support Defines
			string		itcmcs0095.session.dsca(80) mb
		domain	tcmcs.str50m	itcmcs0095.parameter.dsca
		domain	tcdate		itcmcs0095.indt
	#define	CONVERSION.NEEDED
^		itcmcs0095.conversion.necessary
	#define		LENGTH_LOGON_PART	(len(trim$(logname$)) + 3)
	#define	UPDATE.ALLOWED(SESSION, TABLE, ...)
^
^	if mode = DAL_NEW then
^
^		select  ##TABLE##.indt:itcmcs0095.indt	|* read any record
^		from    ##TABLE##
^		as set with 1 rows
^		selectdo
^
^		     |* If a record exists, inserting is not allowed
^			dal.set.error.message("tcmcs009504",
^						itcmcs0095.session.dsca)
^			|* The parameters already exist, use session %1$s to
^			|* change the parameters.
^			return(DALHOOKERROR)
^
^		selectempty
^		     |* Insert zero-record
^		     |	db.set.to.default(t##TABLE##)
^		     |  do NOT use db.set.to.default here whatever VSC says.
^			itcmcs0095.parameter.dsca = ##TABLE##.dsca
^			##TABLE##.indt = 0
^			##TABLE##.dsca = form.text$("tcmcs009508")
^			|* Actual set
^			db.insert(t##TABLE##, db.retry)
^
^		        |* Fill Description and Introduction Date for the new
^		        |* history-record that is about to be inserted
^			if isspace(itcmcs0095.parameter.dsca) then
^				##TABLE##.dsca = sprintf$(form.text$(
^							"tcmcs009511"),
^							logname$)
^				|* Automatic generated default setting (%1$s).
^			else
^                                                    |#kdj_rom.so
|^                         ##TABLE##.dsca = itcmcs0095.parameter.dsca
^                                                    |#kdj_rom.eo
^                          ##TABLE##.dsca =          |#kdj_rom.sn
^                                trim$(itcmcs0095.parameter.dsca) &
^                                " (" & logname$ & ")."    |#kdj_rom.en
^			endif
^			##TABLE##.indt = utc.num()
^			return(0)
^			|* Save will be done by the DAL
^
^		endselect
^	endif
^
^	|* From here onwards the mode is automatically DAL_UPDATE, otherwise
^	|* return would have been executed already.
^
^	if subdal then
^		if itcmcs0095.conversion.needed("##TABLE##",...) then
^			itcmcs0095.session.dsca = tt.session.desc("##SESSION##")
^			dal.set.error.message("tcmcs009503",
^				(itcmcs0095.session.dsca & " (" &
^				"##SESSION##" & ")"))
^				|* Use session %1$s to change parameters which
^				|* need a conversion process to guarantee
^				|* database consistency.
^			return(DALHOOKERROR)
^		endif
^	endif
^
^	|* Only the zero-record may be updated
^	if mode = DAL_UPDATE and ##TABLE##.indt <> 0 then
^		dal.set.error.message("tcmcs009502")
^		|* Modifying historical parameter settings is not allowed.
^		return(DALHOOKERROR)
^	endif
^
^	|* INSERT THE NEW HISTORY-RECORD
^
^	##TABLE##.indt = utc.num()
^	if trim$(tolower$(##TABLE##.dsca)) =
^	   trim$(tolower$(sprintf$(form.text$("tcmcs009508")))) then
^	   |* Actual set
^		##TABLE##.dsca = sprintf$(form.text$("tcmcs009510"), logname$)
^		|* Parameter set defined by %1$s.
^	else
^		if len(trim$(##TABLE##.dsca)) < (50 - LENGTH_LOGON_PART) then
^			##TABLE##.dsca = trim$(##TABLE##.dsca) &
^						" (" & logname$ & ")"
^		else
^			##TABLE##.dsca = ##TABLE##.dsca(1;(50 - LENGTH_LOGON_PART)) &
^						" (" & logname$ & ")"
^		endif
^	endif
^	db.insert(t##TABLE##, db.retry)
^
^	|* FILL FIELDS FOR ZERO-RECORD
^
^	##TABLE##.dsca = sprintf$(form.text$("tcmcs009508"))
^	|* Actual set
^	##TABLE##.indt = 0
^							|#MFS-LogParameter.sn
^	| Log Latest Change if required in tcgen300
|^	tcgen.dll0302.handle.latest.change.log.for.parameter("##TABLE##")
^							|#MFS-LogParameter.en
^	return(0)


function extern long before.open.object.set()
{
	return(0)
}

function extern long before.save.object(	long	mode)
{
	UPDATE.ALLOWED(txamg0100m000, txamg000, "")
	return(0)
}


function extern long check.parameters()
{
	DllUsage
	Expl.	: This function checks if parameter has been set. If not
		  it picks up the current company as default.
	Pre	: -
	Post	: -
	Input	: -
	Output	: -
	Return	: 0
	EndDllUsage

	select	txamg000.*
	from	txamg000
	where	txamg000._index1 = {0}
	as set with 1 rows
	selectdo
	selectempty
		db.retry.point()
		db.set.to.default(ttxamg000)
		txamg000.indt = 0
		txamg000.dsca = form.text$("tcmcs009508")
		db.insert(ttxamg000, db.retry)
		commit.transaction()
	endselect

	return(0)
}
function boolean itcmcs0095.conversion.needed(
			string		file(8),
					...)
{
	|* This function checks if a parameter which need a conversion
	|*process is changed

			long		itcmcs0095.table_id
			long		itcmcs0095.i

	if isspace(get.string.arg(2)) then
		return(false)
	endif
	itcmcs0095.table_id = db.bind("t" & file)
	for itcmcs0095.i = 2 to get.argc()
		|if (dal.get.property.flag(file, itcmcs0095.table_id,
		|   file & "." & get.string.arg(itcmcs0095.i)) = DAL_UPDATE) then
			db.unbind(itcmcs0095.table_id)
			return (true)
		|endif

	endfor
	db.unbind(itcmcs0095.table_id)
	return(false)
}
